# Conexión a Neon (Postgres) — cópiala desde tu dashboard de Neon
DATABASE_URL=postgresql://usuario:password@ep-xxxx.neon.tech/rutinas?sslmode=require

# Secreto para firmar los JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# Cloudinary — los tres valores están en tu dashboard de Cloudinary
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:5173

# Puerto del servidor
PORT=4000
